{
  "name": "moonring-walkthrough",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/export.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:cloudflare": "npm run build && node scripts/cloudflare-assets.mjs && vite build --config vite.cloudflare.config.ts",
    "deploy:cloudflare": "cf deploy --prebuilt --mode production"
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "cf": "1.0.0-beta.26",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
